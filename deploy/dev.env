# Legacy dev environment for `go run ./dev deploy-dev`. The localhost-only
# registry was removed after the GHCR release; restore it explicitly before
# using this historical path. Nothing secret here: the
# Dokploy API key comes from DOKPLOY_API_KEY or ~/.config/lanternfolk/dokploy.key.

# SSH host (an alias from ~/.ssh/config works) running Dokploy and the
# localhost-only registry (registry:2 on 127.0.0.1:5000).
SSH_HOST=tolaniverse-realm
LOCAL_REGISTRY_PORT=15000
REMOTE_REGISTRY_PORT=5000
IMAGE_REPO=lanternfolk
BASE_IMAGE=cgr.dev/chainguard/static:latest

DOKPLOY_URL=https://dokploy.tolaniverse.xyz
DOKPLOY_APPLICATION_ID=gWeHbQsg-atYKyzzxhMNM
PUBLIC_URL=https://lanternfolk.tolaniverse.xyz
